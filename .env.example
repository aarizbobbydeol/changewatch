# ChangeWatch Environment Configuration

# Encryption master key (REQUIRED). Wraps every project's data key.
# Generate once with: openssl rand -hex 32
# Back it up: if it is lost, stored stack traces and diffs cannot be decrypted.
# docker compose refuses to start without it.
MASTER_KEY=
# Set to the old key while running `app.cli rotate-master-key`
MASTER_KEY_PREVIOUS=

# Docker Compose secrets (used by docker-compose.yml)
# Use hex values (openssl rand -hex 32) so they are safe inside connection URLs.
# POSTGRES_PASSWORD only takes effect when the Postgres volume is first created.
POSTGRES_USER=changewatch
POSTGRES_PASSWORD=changewatch
POSTGRES_DB=changewatch
REDIS_PASSWORD=changewatch_secret_password
# Domain for automatic HTTPS (docker compose --profile tls up -d)
PUBLIC_HOSTNAME=localhost

# Database & Queue (local development without Docker; compose builds its own URLs)
DATABASE_URL=postgresql://changewatch:changewatch@localhost:5432/changewatch
REDIS_URL=redis://localhost:6379/0

# Dev Seeding (set to 1 to auto-seed 'cw_test_key_123' for 'my-test-app')
SEED_DEV_PROJECT=0

# LLM Provider Configuration
# Choose: "anthropic", "ollama", or "fake"
LLM_PROVIDER=anthropic

# Anthropic Provider Settings
ANTHROPIC_API_KEY=
# Fast model: automatic investigations and deploy summaries. Deep model: "Dig deeper".
LLM_MODEL_FAST=claude-sonnet-5-5
LLM_MODEL_DEEP=claude-opus-5-5
# Reasoning effort: low, medium, high, xhigh or max (higher is slower and costs more)
LLM_EFFORT_FAST=medium
LLM_EFFORT_DEEP=high

# Ollama Provider Settings (Local, no data leaves machine)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3

# Fallback fake LLM flag
DRY_RUN_LLM=0

# Typed Decisions Provider (Choose: "rules", "jev", or "fake")
DECISION_PROVIDER=rules
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-2024-10

# Rate Limiting & Detection
RATE_LIMIT_PER_MIN=600
# One heartbeat a minute per app process: the most processes one ingest key can have
HEARTBEAT_LIMIT_PER_MIN=1200
SPIKE_MIN_EVENTS=10
SPIKE_RATIO=3.0

# Release Verdict Checkpoints & Thresholds
VERDICT_FIRST_MIN=10
VERDICT_FINAL_MIN=30
VERDICT_ROLLBACK_NEW_ISSUE_EVENTS=20
VERDICT_ROLLBACK_ABS_RATE=0.25
NOTIFY_ON_SAFE=1

# Data Retention
RETENTION_DAYS=30

# Server Network Settings
HOST=0.0.0.0
PORT=8000

# Usage Metering Settings (Usage Metering Addendum)
METER_ENVIRONMENTS=prod
# USD per million tokens, used to meter AI cost (output includes the model's thinking)
# Also prices your app's own AI calls for cost tracking (record_ai_usage); add your models here,
# or send the exact cost from the SDK. Models without a price are counted but not priced.
LLM_PRICES_JSON={"claude-sonnet-5-5":{"input":2.0,"output":10.0},"claude-opus-5-5":{"input":4.0,"output":20.0},"claude-haiku-5-5":{"input":0.1,"output":0.5}}
FREE_CREDIT_MICROS=0
DEFAULT_SOFT_LIMIT_MICROS=
DEFAULT_HARD_LIMIT_MICROS=
# Opt-In Telemetry Settings (Off by default, strictly allowlisted aggregates)
TELEMETRY_ENABLED=0
TELEMETRY_COLLECTOR_URL=http://localhost:8001
TELEMETRY_INSTALL_ID_PATH=.telemetry_id

# Operator alerts about ChangeWatch itself (worker/detector/notifier/database down,
# alerts that could not be delivered). Slack, Discord or Teams incoming webhook URL.
# Sent directly, not through the outbox. Empty = logged only.
SYSTEM_ALERT_WEBHOOK_URL=
# Optional healthchecks.io-style URL pinged every detector cycle (/fail appended when down)
WATCHDOG_PING_URL=

# ---------------------------------------------------------------------------
# Advanced settings (defaults shown; usually no need to change)
# ---------------------------------------------------------------------------
# Database & runtime
DATABASE_SSL=0
DB_POOL_PER_PROCESS=10
API_WORKERS=auto
WORKER_PROCESSES=auto
MAX_MEMORY_MB=512
# Alternative to MASTER_KEY: path to a file holding the key (needs a mounted secret)
MASTER_KEY_FILE=

# Ingest pipeline
QUEUE_SOFT_LIMIT=10000
QUEUE_VISIBILITY_TIMEOUT_SEC=60
STORE_FULL_PER_MIN=20
# Hours an event_id is remembered so a re-sent event is counted once
DEDUPE_WINDOW_HOURS=24

# Data handling and retention
SCRUB_PII=1
# stored = keep scrubbed diffs/file contents (encrypted); ephemeral = metadata only
CODE_MODE=stored
CODE_RETENTION_DAYS=7
# Read-only GitHub token for ephemeral mode (contents:read on the repo)
GITHUB_READ_TOKEN=
# GitHub API for the opt-in draft revert pull requests (each project stores its own token in Settings).
# GitHub Enterprise Server: https://YOUR-HOST/api/v3
GITHUB_API_URL=https://api.github.com
# Send code excerpts to the hosted decision provider (off by default)
DECISION_SEND_CODE=0
DECISION_STATE_MAX_CHARS=16000
SECRET_GUARD_ENABLED=false

# Detection and calm alerting
SILENT_AFTER_MIN=10
STALE_AFTER_SEC=180
MAX_ALERTS_PER_HOUR=10
GROUP_AFTER=3
ESCALATE_AFTER_MIN=10
RESOLVE_AFTER_MIN=30
OUTBOX_MAX_AGE_HOURS=24

# Weekly digest (sent to every channel of projects that deployed that week)
DIGEST_DAY=mon
DIGEST_HOUR=9
DIGEST_TIMEZONE=UTC

# Signed one-click action links; derived from MASTER_KEY when empty
LINK_SIGNING_SECRET=
# Slack app signing secret; Slack button interactions are disabled until set
SLACK_SIGNING_SECRET=

# AI concurrency
INVESTIGATION_CONCURRENCY=4
OLLAMA_CONCURRENCY=1

# Usage metering
PRICE_BOOK_FILE=config/price_book.default.yaml
USAGE_FLUSH_SEC=60
# Owner/admin endpoints (export, purge, margin); leave empty to disable
ADMIN_API_KEY=

# Version of the published images used by docker-compose.release.yml
CHANGEWATCH_VERSION=latest

# Optional demo traffic (docker compose --profile demo up -d demo); see docs/DEMO.md
DEMO_INGEST_KEY=
DEMO_DEPLOY_EVERY_MIN=30
DEMO_REQUESTS_PER_MIN=450
DEMO_FIRST_BAD_AFTER_MIN=5
DEMO_FIX_AFTER_MIN=10
DEMO_HISTORY_MIN=30
