# ==============================================================================
# ChangeWatch Reverse Proxy Caddyfile
# ==============================================================================
# Automatic HTTPS: Let's Encrypt for a public domain. For localhost and IP addresses
# Caddy uses its own internal CA automatically (no `tls` line needed; `tls` is a
# site-level directive and is not allowed inside `handle`).
# ==============================================================================

{$PUBLIC_HOSTNAME:localhost} {
    # API routes & ingest endpoints
    handle /v1/* {
        reverse_proxy api:8000
    }
    handle /api/* {
        reverse_proxy api:8000
    }
    handle /healthz {
        reverse_proxy api:8000
    }
    # Signed one-click action links from alerts
    handle /a/* {
        reverse_proxy api:8000
    }

    # Dashboard Web UI
    handle {
        reverse_proxy dashboard:3000
    }
}
